{
    "dataset_name": "SMD",
    "dataset_path": "data/raw",
    "num_machines": 28,
    "num_sensors": 38,
    "window_size": 100,
    "window_stride": 1,
    "purge_gap_windows": 99,
    "split_ratio": [
        0.7,
        0.15,
        0.15
    ],
    "graph_rule": {
        "type": "absolute_correlation",
        "threshold": 0.6,
        "source": "machine_own_train_block"
    },
    "node_features": {
        "type": "6-D",
        "dimensions": [
            "mean",
            "std",
            "skewness",
            "kurtosis",
            "max_abs_dev",
            "fft_dominant_freq_magnitude"
        ]
    },
    "model": {
        "architecture": "GATAnomalyDetector",
        "in_dim": 6,
        "hidden_dim": 64,
        "num_heads": 4,
        "num_layers": 2,
        "edge_dim": 1,
        "dropout": 0.2
    },
    "training": {
        "batch_size": 64,
        "learning_rate": 0.001,
        "weight_decay": 0.0001,
        "epochs": 20,
        "patience": 10,
        "loss": "BCEWithLogitsLoss",
        "optimizer": "Adam",
        "device": "cpu",
        "early_stopping_target": "val_loss"
    },
    "detection_threshold_search": {
        "min": 0.01,
        "max": 0.99,
        "step": 0.01,
        "criterion": "max_val_f1"
    },
    "attribution": {
        "fine_window_margin": 15,
        "ig_steps": 50,
        "ig_baseline": "zero",
        "gnnexplainer_epochs": 60,
        "gnnexplainer_lr": 0.05
    },
    "conformal": {
        "alpha_values": [
            0.1,
            0.2
        ],
        "recall_targets": [
            1.0,
            0.8
        ],
        "quantile_rule": "ceil((n+1)(1-alpha))/n"
    },
    "abstention_gate": {
        "explanation_top_k": 5,
        "min_topk_mass": 0.7,
        "min_sensor_std": 0.001,
        "tau_grid": [
            0.0,
            0.05,
            0.1,
            0.15,
            0.2,
            0.25,
            0.3,
            0.35,
            0.4,
            0.45,
            0.5,
            0.55,
            0.6,
            0.65,
            0.7,
            0.75,
            0.8,
            0.85,
            0.9,
            0.95
        ]
    },
    "llm": {
        "model_name": "meta/llama-3.1-70b-instruct",
        "temperature": 0.0,
        "max_tokens": 600,
        "max_retries": 3,
        "backoff_base": 2.0
    }
}